{
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "lint": "eslint --max-warnings=0 .",
    "lint:fix": "eslint --max-warnings=0 --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage",
    "check:content": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-content.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "check:site": "html-validate out && linkinator out",
    "ci": "npm run lint && npm run format:check && npm run typecheck && npm test -- --ci && npm run check:content && npm run check:assets && npm run build && npm run check:site"
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "mdast-util-to-string": "^4.0.0",
    "next-themes": "^0.4.6",
    "react-dom": "^19.1.0",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20.19.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.12",
    "eslint-config-prettier": "^10.1.8",
    "html-validate": "^11.21.1",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "linkinator": "^8.1.0",
    "next": "^15.3.4",
    "postcss": "^8.5.5",
    "prettier": "3.9.10",
    "react": "^19.1.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  }
}
