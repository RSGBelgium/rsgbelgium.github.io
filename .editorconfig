# Editor settings for the RSG-Belgium website: https://editorconfig.org
# Most editors apply these automatically (VS Code needs the EditorConfig extension).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
# Two trailing spaces are a hard line break in Markdown: keep them.
trim_trailing_whitespace = false
